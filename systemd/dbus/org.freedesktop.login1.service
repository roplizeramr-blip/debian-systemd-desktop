# D-Bus activation file for the container's logind facade.
#
# The systemd package ships this file pointing at /bin/false: logind is meant
# to be started by PID 1, and this image runs Supervisor there instead.  Point
# the name at scripts/login1-stub.py so Inhibit() and the capability queries
# used by desktop applications get an answer instead of Spawn.ChildExited.
#
# The bus policy in /usr/share/dbus-1/system.d/org.freedesktop.login1.conf
# already allows root to own org.freedesktop.login1 and allows unprivileged
# callers to send Inhibit().
[D-BUS Service]
Name=org.freedesktop.login1
Exec=/usr/local/bin/login1-stub.py
User=root
