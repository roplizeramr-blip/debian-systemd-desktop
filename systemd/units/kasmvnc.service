[Unit]
Description=KasmVNC Desktop Server
Documentation=https://kasmweb.com/kasmvnc/docs
After=dbus.service
Wants=dbus.service

[Service]
Type=simple
User=desktop
Group=desktop
Environment=DISPLAY=:1
Environment=HOME=/home/desktop
Environment=USER=desktop
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/local/bin/start-kasmvnc.sh
Restart=always
RestartSec=2
KillMode=control-group

[Install]
WantedBy=graphical.target
