[Unit]
Description=Tailscale Serve private TCP forwarder
Documentation=https://tailscale.com/kb/1242/tailscale-serve
After=tailscaled.service kasmvnc.service
Wants=tailscaled.service kasmvnc.service

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
ExecStart=/usr/local/bin/tailscale-serve.sh
Restart=always
RestartSec=3
KillMode=control-group

[Install]
WantedBy=graphical.target
