[Unit]
Description=Public control page and Tailscale login helper
Documentation=file:///opt/desktop/web/index.html
After=kasmvnc.service tailscaled.service
Wants=kasmvnc.service tailscaled.service

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
Environment=CONTROL_PORT=3000
Environment=KASM_HOST=127.0.0.1
Environment=KASM_PORT=6080
ExecStart=/usr/bin/python3 /usr/local/bin/control-server.py
Restart=always
RestartSec=2
KillMode=control-group

[Install]
WantedBy=graphical.target
