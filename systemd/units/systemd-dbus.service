[Unit]
Description=systemd D-Bus Compatibility Service
Documentation=man:systemd(1)
After=dbus.service systemd-journald.service
Requires=dbus.service
Wants=systemd-journald.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/systemd-compat/systemd_dbus.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
